{
  "name": "fusebox-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Fusebox · The autonomous cost circuit breaker for AI agents",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "mcp:build": "pnpm --filter @fusebox/mcp-server build",
    "mcp:dev": "pnpm --filter @fusebox/mcp-server dev",
    "mcp:start": "pnpm --filter @fusebox/mcp-server start"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
