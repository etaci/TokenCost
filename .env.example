OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Fusebox Configuration
FUSEBOX_CONFIG=fusebox.yaml
FUSEBOX_DATA_DIR=.fusebox
RUST_LOG=info

# Database (if using Postgres)
DATABASE_URL=postgresql://fusebox:fusebox@localhost:5432/fusebox

# MCP Server
FUSEBOX_URL=http://localhost:8080
FUSEBOX_TENANT=default
